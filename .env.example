# Copie este arquivo para `.env.local` e preencha com as credenciais do projeto Firebase.
# Nunca envie o `.env.local` para o git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Painel Administrativo (/admin)
# VITE_ADMIN_WHATSAPP: WhatsApp do admin (APENAS numeros, com DDI+DDD).
#   Ex.: 5511980168744 — usado pelo botao "TENHO INTERESSE" do Radar e pela
#   renovacao de assinatura (R$ 19,90).
VITE_ADMIN_WHATSAPP=5511980168744
# VITE_ADMIN_EMAIL: precisa ser o MESMO valor usado no firestore.rules
#   (colecoes /users e /oportunidades) — ex.: seu_email_admin@exemplo.com.
VITE_ADMIN_EMAIL=seu_email_admin@exemplo.com

# ImgBB — upload de fotos 100% GRATUITO, sem cartao de credito.
# Crie sua chave em https://api.imgbb.com/ e cole abaixo (apenas a chave, ex:
#   abc123def456...). Usada no form "Postar Vaga" para gerar a URL publica da
#   foto que aparece no Radar.
VITE_IMGBB_API_KEY=